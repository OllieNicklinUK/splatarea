# Lambda admin credential — never commit real value
LAMBDA_AUTHKEY=replace_with_lambda_authkey

# Target app scope — must match clientId in index.html
LAMBDA_GAME_ID=replace_with_real_app_id

# Required for prices_event
PRICES_API_KEY=replace_with_your_prices_api_key

# Optional: override the prices endpoint URL
# PRICES_API_URL=https://api.example-prices.com/v1/quotes
