# Server Configuration
PORT=3000

# AI Services
GOOGLE_API_KEY=your_google_api_key_here
# Private-key mode (alternative to GOOGLE_API_KEY)
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# or:
# GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Viverse SDK Configuration (Pending details)
VIVERSE_SDK_KEY=your_viverse_sdk_key_here

# Logging
LOG_LEVEL=info

# Agent Delegation
VIVERSE_AGENT_ENDPOINT=http://localhost:3000/api/ai/chat

# External skills repository (recommended side-by-side checkout)
VIVERSE_SKILLS_REPO=../viverse-sdk-skills
# Optional: point directly to the skills directory
# VIVERSE_SKILLS_DIR=/absolute/path/to/viverse-sdk-skills/skills

# Browser Auto-Test (Playwright)
# 0: disable browser runtime probe entirely
# 1: enable browser runtime probe
VIVERSE_BROWSER_AUTOTEST=1
# auto: try scripted login
# manual: open headed browser, wait for real user login, then continue tests
VIVERSE_BROWSER_AUTH_MODE=auto
# Optional: force headed mode in auto auth (debug)
VIVERSE_PLAYWRIGHT_HEADFUL=false
# Optional: manual mode wait timeout (ms)
VIVERSE_BROWSER_MANUAL_LOGIN_TIMEOUT_MS=180000
# Optional: persisted storage state path for session reuse across runs
# VIVERSE_PLAYWRIGHT_STORAGE_STATE=/absolute/path/to/storage-state.json

# AI Provider selection — switch between 'gemini' and 'openai'
AI_PROVIDER=gemini

# Model tiering — Gemini
# PRO  → ORCHESTRATOR, ARCHITECT, CODER, SUMMARIZER (complex reasoning)
# FLASH → PHASE0_ROUTER, GENERAL, REVIEWER, VERIFIER (speed/pattern-match)
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3-flash-preview

# Model tiering — OpenAI (used when AI_PROVIDER=openai)
#
# Option A — Standard OpenAI (plain API key):
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
#
# Option B — Azure OpenAI (JSON string, single line, from Azure portal):
# OPENAI_API_KEY={"api_key":"YOUR_AZURE_KEY","endpoint":"https://YOUR_RESOURCE.openai.azure.com/","deployment":"gpt-4o","api_version":"2024-02-01"}
#   - deployment: the model deployment name in your Azure resource
#   - api_version: check Azure docs for supported versions (e.g. 2024-02-01)
#   - OPENAI_MODEL_PRO/FLASH are ignored when using Azure JSON key (deployment name is used instead)
#
# OPENAI_MODEL_PRO=gpt-5.4
# OPENAI_MODEL_FLASH=gpt-5.4-mini

# Agent task timeouts (ms). Pro-tier agents get longer defaults automatically.
# Override here if needed.
# ORCHESTRATOR_TASK_IDLE_TIMEOUT_MS=300000    # idle between tool calls (pro default: 5min)
# ORCHESTRATOR_TASK_DURATION_TIMEOUT_MS=720000 # max total task time (pro default: 12min)
